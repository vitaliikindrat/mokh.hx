diff --git a/helix-view/src/annotations/virtual_text.rs b/helix-view/src/annotations/virtual_text.rs
new file mode 100644
index 0000000..42a9735
--- /dev/null
+++ b/helix-view/src/annotations/virtual_text.rs
@@ -0,0 +1,338 @@
+//! Plugin-provided virtual text: blocks of styled rows rendered below a
+//! document line, and whole-line highlights. Items are anchored by char
+//! index so they follow edits the way inlay hints do. A plugin adds them
+//! (for example deleted lines of a diff under the line they used to follow,
+//! and a highlight on the lines that were added) and removes them again.
+
+use helix_core::doc_formatter::FormattedGrapheme;
+use helix_core::text_annotations::LineAnnotation;
+use helix_core::unicode::width::UnicodeWidthStr;
+use helix_core::{Assoc, ChangeSet, Position, RopeSlice};
+use serde::Deserialize;
+
+#[derive(Debug, Clone, Deserialize, PartialEq, Eq)]
+pub struct VirtualSpan {
+    pub text: String,
+    /// Theme scope for this span, e.g. `diff.minus`; empty uses the row style.
+    #[serde(default)]
+    pub style: String,
+}
+
+#[derive(Debug, Clone, Deserialize, PartialEq, Eq)]
+pub struct VirtualLine {
+    /// Theme scope painted across the whole row first, e.g. `ui.virtual.diff.minus`.
+    #[serde(default)]
+    pub style: String,
+    #[serde(default)]
+    pub spans: Vec<VirtualSpan>,
+}
+
+impl VirtualLine {
+    /// Display width of the whole line.
+    pub fn width(&self) -> usize {
+        self.spans.iter().map(|s| s.text.width()).sum()
+    }
+
+    /// Screen rows the line takes when wrapped at `viewport_width` columns;
+    /// the painter wraps the same way, so layout and rendering agree.
+    pub fn rows(&self, viewport_width: usize) -> usize {
+        if viewport_width == 0 {
+            return 1;
+        }
+        self.width().div_ceil(viewport_width).max(1)
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum VirtualItemKind {
+    /// Rows rendered below the line holding the anchor.
+    Lines(Vec<VirtualLine>),
+    /// A theme scope painted over the whole line holding the anchor.
+    LineHighlight(String),
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct VirtualItem {
+    pub id: usize,
+    /// Char index; the item belongs to the document line containing it.
+    pub anchor: usize,
+    pub kind: VirtualItemKind,
+}
+
+#[derive(Debug, Default, Clone)]
+pub struct VirtualText {
+    items: Vec<VirtualItem>,
+    next_id: usize,
+}
+
+impl VirtualText {
+    pub fn is_empty(&self) -> bool {
+        self.items.is_empty()
+    }
+
+    pub fn items(&self) -> &[VirtualItem] {
+        &self.items
+    }
+
+    fn push(&mut self, anchor: usize, kind: VirtualItemKind) -> usize {
+        self.next_id += 1;
+        self.items.push(VirtualItem {
+            id: self.next_id,
+            anchor,
+            kind,
+        });
+        self.next_id
+    }
+
+    /// Rows shown below the line containing `anchor`. Returns an id for removal.
+    pub fn add_lines(&mut self, anchor: usize, lines: Vec<VirtualLine>) -> usize {
+        self.push(anchor, VirtualItemKind::Lines(lines))
+    }
+
+    /// Paints `style` (a theme scope) over the line containing `anchor`.
+    pub fn add_line_highlight(&mut self, anchor: usize, style: String) -> usize {
+        self.push(anchor, VirtualItemKind::LineHighlight(style))
+    }
+
+    pub fn remove(&mut self, id: usize) -> bool {
+        let before = self.items.len();
+        self.items.retain(|item| item.id != id);
+        before != self.items.len()
+    }
+
+    pub fn clear(&mut self) {
+        self.items.clear();
+    }
+
+    /// Keep anchors in place across an edit, like inlay hints.
+    pub fn map_changes(&mut self, changes: &ChangeSet) {
+        changes.update_positions(
+            self.items
+                .iter_mut()
+                .map(|item| (&mut item.anchor, Assoc::After)),
+        );
+    }
+
+    /// Row blocks keyed by the char index of the newline ending their line
+    /// (the text length for an unterminated last line), sorted by it.
+    pub fn blocks_by_line_end<'a>(&'a self, text: RopeSlice) -> Vec<(usize, &'a [VirtualLine])> {
+        let mut blocks: Vec<(usize, &[VirtualLine])> = self
+            .items
+            .iter()
+            .filter_map(|item| match &item.kind {
+                VirtualItemKind::Lines(lines) if !lines.is_empty() => {
+                    Some((line_end_char(text, item.anchor), lines.as_slice()))
+                }
+                _ => None,
+            })
+            .collect();
+        blocks.sort_by_key(|(end, _)| *end);
+        blocks
+    }
+
+    /// Highlighted document lines with their scopes, sorted by line.
+    pub fn line_highlights(&self, text: RopeSlice) -> Vec<(usize, &str)> {
+        let mut lines: Vec<(usize, &str)> = self
+            .items
+            .iter()
+            .filter_map(|item| match &item.kind {
+                VirtualItemKind::LineHighlight(style) => Some((
+                    text.char_to_line(item.anchor.min(text.len_chars())),
+                    style.as_str(),
+                )),
+                _ => None,
+            })
+            .collect();
+        lines.sort_by_key(|(line, _)| *line);
+        lines
+    }
+}
+
+/// Char index of the newline that ends the line containing `anchor`, or the
+/// text length when that is the last, unterminated line.
+pub fn line_end_char(text: RopeSlice, anchor: usize) -> usize {
+    let anchor = anchor.min(text.len_chars());
+    let line = text.char_to_line(anchor);
+    if line + 1 < text.len_lines() {
+        text.line_to_char(line + 1) - 1
+    } else {
+        text.len_chars()
+    }
+}
+
+/// Walks the sorted blocks alongside the document formatter: the newline
+/// grapheme of a block's line is its anchor; once that grapheme has been
+/// processed the block is pending and is emitted at that line's end. Used
+/// by both the layout side (`LineAnnotation`, reserving rows) and the
+/// render side (the decoration painting them), so the two always agree.
+pub struct VirtualLinesWalker<'a> {
+    blocks: Vec<(usize, &'a [VirtualLine])>,
+    idx: usize,
+    pending: Option<(usize, usize)>,
+}
+
+impl<'a> VirtualLinesWalker<'a> {
+    pub fn new(blocks: Vec<(usize, &'a [VirtualLine])>) -> Self {
+        VirtualLinesWalker {
+            blocks,
+            idx: 0,
+            pending: None,
+        }
+    }
+
+    /// Start a traversal at `char_idx`; returns the next anchor to watch.
+    pub fn reset(&mut self, char_idx: usize) -> usize {
+        self.pending = None;
+        self.idx = self.blocks.partition_point(|(end, _)| *end < char_idx);
+        self.next_anchor()
+    }
+
+    fn next_anchor(&self) -> usize {
+        self.blocks
+            .get(self.idx)
+            .map_or(usize::MAX, |(end, _)| *end)
+    }
+
+    /// The grapheme at `char_idx` was reached; returns the next anchor.
+    pub fn anchor_reached(&mut self, char_idx: usize) -> usize {
+        let start = self.idx;
+        while self
+            .blocks
+            .get(self.idx)
+            .is_some_and(|(end, _)| *end == char_idx)
+        {
+            self.idx += 1;
+        }
+        if self.idx > start {
+            self.pending = Some((start, self.idx));
+        }
+        self.next_anchor()
+    }
+
+    /// Rows for the line that just ended, if its anchor was reached.
+    pub fn take_pending(&mut self) -> Vec<&'a VirtualLine> {
+        match self.pending.take() {
+            Some((start, end)) => self.blocks[start..end]
+                .iter()
+                .flat_map(|(_, lines)| lines.iter())
+                .collect(),
+            None => Vec::new(),
+        }
+    }
+}
+
+/// Reserves the rows in the layout; the matching painter lives in helix-term.
+/// `viewport_width` is the text area width the painter wraps at.
+pub struct VirtualLinesAnnotation<'a> {
+    walker: VirtualLinesWalker<'a>,
+    viewport_width: usize,
+}
+
+impl<'a> VirtualLinesAnnotation<'a> {
+    pub fn new(blocks: Vec<(usize, &'a [VirtualLine])>, viewport_width: usize) -> Self {
+        VirtualLinesAnnotation {
+            walker: VirtualLinesWalker::new(blocks),
+            viewport_width,
+        }
+    }
+}
+
+impl LineAnnotation for VirtualLinesAnnotation<'_> {
+    fn reset_pos(&mut self, char_idx: usize) -> usize {
+        self.walker.reset(char_idx)
+    }
+
+    fn process_anchor(&mut self, grapheme: &FormattedGrapheme) -> usize {
+        self.walker.anchor_reached(grapheme.char_idx)
+    }
+
+    fn insert_virtual_lines(
+        &mut self,
+        _line_end_char_idx: usize,
+        _line_end_visual_pos: Position,
+        _doc_line: usize,
+    ) -> Position {
+        let rows = self
+            .walker
+            .take_pending()
+            .iter()
+            .map(|line| line.rows(self.viewport_width))
+            .sum();
+        Position::new(rows, 0)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use helix_core::Rope;
+
+    fn line(text: &str) -> VirtualLine {
+        VirtualLine {
+            style: String::new(),
+            spans: vec![VirtualSpan {
+                text: text.to_string(),
+                style: String::new(),
+            }],
+        }
+    }
+
+    #[test]
+    fn blocks_are_keyed_by_their_lines_newline() {
+        let rope = Rope::from("ab\ncd\nef");
+        let mut vt = VirtualText::default();
+        let second = vt.add_lines(4, vec![line("x")]); // inside "cd"
+        vt.add_lines(0, vec![line("y"), line("z")]); // inside "ab"
+        vt.add_lines(7, vec![line("w")]); // inside "ef", no trailing newline
+        let blocks = vt.blocks_by_line_end(rope.slice(..));
+        assert_eq!(
+            blocks.iter().map(|(end, b)| (*end, b.len())).collect::<Vec<_>>(),
+            vec![(2, 2), (5, 1), (8, 1)]
+        );
+        assert!(vt.remove(second));
+        assert!(!vt.remove(second));
+        assert_eq!(vt.blocks_by_line_end(rope.slice(..)).len(), 2);
+    }
+
+    #[test]
+    fn walker_emits_once_per_anchored_line() {
+        let rope = Rope::from("ab\ncd\nef\n");
+        let mut vt = VirtualText::default();
+        vt.add_lines(3, vec![line("x")]);
+        vt.add_lines(4, vec![line("y")]);
+        let blocks = vt.blocks_by_line_end(rope.slice(..));
+        let mut walker = VirtualLinesWalker::new(blocks);
+        assert_eq!(walker.reset(0), 5);
+        assert!(walker.take_pending().is_empty());
+        // a soft-wrap point inside the line: nothing yet
+        assert_eq!(walker.anchor_reached(4), 5);
+        assert!(walker.take_pending().is_empty());
+        assert_eq!(walker.anchor_reached(5), usize::MAX);
+        assert_eq!(walker.take_pending().len(), 2);
+        assert!(walker.take_pending().is_empty());
+        // starting a traversal after the anchor skips it
+        assert_eq!(walker.reset(6), usize::MAX);
+    }
+
+    #[test]
+    fn long_lines_wrap_into_several_rows() {
+        let l = line(&"x".repeat(25));
+        assert_eq!(l.rows(10), 3);
+        assert_eq!(l.rows(25), 1);
+        assert_eq!(l.rows(100), 1);
+        assert_eq!(line("").rows(10), 1);
+        assert_eq!(l.rows(0), 1);
+    }
+
+    #[test]
+    fn anchors_follow_edits() {
+        let rope = Rope::from("ab\ncd\n");
+        let mut vt = VirtualText::default();
+        vt.add_line_highlight(3, "x".into());
+        let transaction = helix_core::Transaction::insert(&rope, &helix_core::Selection::point(0), "NEW\n".into());
+        vt.map_changes(transaction.changes());
+        let mut rope = rope;
+        transaction.apply(&mut rope);
+        assert_eq!(vt.line_highlights(rope.slice(..)), vec![(2, "x")]);
+    }
+}
