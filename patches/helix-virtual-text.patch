+// "add-virtual-lines": rows of styled text rendered below a document line
+// of the focused document. `lines_json` is a JSON array of
+// {"style": "<theme scope>", "spans": [{"text": "...", "style": "<scope>"}]}.
+pub fn add_virtual_lines(cx: &mut Context, line: usize, lines_json: SteelString) -> Option<usize> {
+    let lines: Vec<helix_view::annotations::virtual_text::VirtualLine> =
+        serde_json::from_str(lines_json.as_str()).ok()?;
