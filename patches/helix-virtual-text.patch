+//! Paints plugin virtual text: rows reserved by
+//! [`VirtualLinesAnnotation`](helix_view::annotations::virtual_text::VirtualLinesAnnotation)
+//! and whole-line highlights.
+
+use helix_core::doc_formatter::FormattedGrapheme;
+use helix_core::unicode::width::UnicodeWidthChar;
+use helix_core::Position;
+use helix_view::annotations::virtual_text::VirtualLinesWalker;
+use helix_view::graphics::Rect;
+use helix_view::theme::Style;
+use helix_view::{Document, Theme};
+
+use crate::ui::document::{LinePos, TextRenderer};
+use crate::ui::text_decorations::Decoration;
+
+pub struct VirtualTextDecoration<'a> {
+    walker: VirtualLinesWalker<'a>,
+    highlights: Vec<(usize, Style)>,
+    theme: &'a Theme,
+    /// Text area width; long rows wrap at it, matching the rows the
+    /// annotation reserved.
+    viewport_width: usize,
+}
+
+impl<'a> VirtualTextDecoration<'a> {
+    pub fn new(doc: &'a Document, theme: &'a Theme, viewport_width: usize) -> Self {
+        let text = doc.text().slice(..);
+        VirtualTextDecoration {
+            walker: VirtualLinesWalker::new(doc.virtual_text.blocks_by_line_end(text)),
+            highlights: doc
+                .virtual_text
+                .line_highlights(text)
+                .into_iter()
+                .map(|(line, scope)| (line, theme.get(scope)))
+                .collect(),
+            theme,
+            viewport_width,
+        }
+    }
+}
+
+impl Decoration for VirtualTextDecoration<'_> {
+    fn reset_pos(&mut self, pos: usize) -> usize {
+        self.walker.reset(pos)
+    }
+
+    fn decorate_grapheme(
+        &mut self,
+        _renderer: &mut TextRenderer,
+        grapheme: &FormattedGrapheme,
+    ) -> usize {
+        self.walker.anchor_reached(grapheme.char_idx)
+    }
+
+    fn decorate_line(&mut self, renderer: &mut TextRenderer, pos: LinePos) {
+        if let Ok(i) = self
+            .highlights
+            .binary_search_by_key(&pos.doc_line, |(line, _)| *line)
+        {
+            let style = self.highlights[i].1;
+            let viewport = renderer.viewport;
+            renderer.set_style(
+                Rect::new(viewport.x, pos.visual_line, viewport.width, 1),
+                style,
+            );
+        }
+    }
+
+    fn render_virt_lines(
+        &mut self,
+        renderer: &mut TextRenderer,
+        pos: LinePos,
+        virt_off: Position,
+    ) -> Position {
+        let lines = self.walker.take_pending();
+        if lines.is_empty() {
+            return Position::new(0, 0);
+        }
+        let viewport = renderer.viewport;
+        let width = self.viewport_width.max(1);
+        let last_row = (renderer.offset.row + viewport.height as usize) as u16;
+        let first_row = pos.visual_line + virt_off.row as u16;
+        let mut row = first_row;
+        let mut reserved = 0usize;
+        for line in &lines {
+            let rows = line.rows(width);
+            reserved += rows;
+            let row_end = row + rows as u16; // rows this line may use
+            let row_style = if line.style.is_empty() {
+                Style::default()
+            } else {
+                self.theme.get(&line.style)
+            };
+            for r in row..row_end.min(last_row) {
+                renderer.set_style(Rect::new(viewport.x, r, viewport.width, 1), row_style);
+            }
+            // Wrap at `width` columns, one grapheme at a time, exactly as
+            // `VirtualLine::rows` counted.
+            let mut col = 0usize;
+            let mut buf = String::new();
+            let mut buf_col = 0usize;
+            for span in &line.spans {
+                let style = if span.style.is_empty() {
+                    row_style
+                } else {
+                    row_style.patch(self.theme.get(&span.style))
+                };
+                for ch in span.text.chars() {
+                    let cw = ch.width().unwrap_or(0);
+                    if col + cw > width && col > 0 {
+                        if row < last_row {
+                            renderer.set_stringn(viewport.x + buf_col as u16, row, &buf, width - buf_col, style);
+                        }
+                        buf.clear();
+                        row += 1;
+                        col = 0;
+                        buf_col = 0;
+                        if row >= row_end {
+                            break;
+                        }
+                    }
+                    buf.push(ch);
+                    col += cw;
+                }
+                if row >= row_end {
+                    break;
+                }
+                if !buf.is_empty() && row < last_row {
+                    renderer.set_stringn(viewport.x + buf_col as u16, row, &buf, width - buf_col, style);
+                }
+                buf_col = col;
+                buf.clear();
+            }
+            row = row_end;
+        }
+        Position::new(reserved, 0)
+    }
+}
